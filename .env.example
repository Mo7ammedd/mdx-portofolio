# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# Set up a local login with: node scripts/setup-ask.mjs --email you@example.com
ASK_ADMIN_EMAIL=
ASK_ADMIN_PASSWORD=

# Required on Vercel. Apply supabase/migrations/202609170001_ask.sql first.
# Without these, `next dev` uses .data/ask.json; production never uses a local file.
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL is also accepted for the project URL.
SUPABASE_SECRET_KEY=
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported instead of the secret key.
