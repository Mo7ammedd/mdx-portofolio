+        private static async Task<byte[]> ReadBlockAsync(FileStream stream, BlockHandle handle)
+        {
+            var fileLength = (ulong)stream.Length;
+            if (handle.Length == 0 || handle.Length > int.MaxValue ||
+                handle.Offset > fileLength || handle.Length > fileLength - handle.Offset)
+                throw new InvalidDataException("SSTable block is outside the file or has an invalid length");
+
+            var buffer = new byte[(int)handle.Length];
+            var bytesRead = 0;
+            while (bytesRead < buffer.Length)
+            {
+                // Explicit offsets avoid racing on a shared FileStream cursor. A read may
+                // return fewer bytes than requested, so only decode after filling the block.
+                var count = await RandomAccess.ReadAsync(stream.SafeFileHandle,
+                    buffer.AsMemory(bytesRead), (long)handle.Offset + bytesRead);
+                if (count == 0)
+                    throw new EndOfStreamException("SSTable block ended before its recorded length");
+                bytesRead += count;
+            }
+            return buffer;
+        }
