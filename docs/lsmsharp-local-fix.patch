+++ b/Tests/StorageRegressionTests.cs
@@ -0,0 +1,197 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using LSMTree.Core;
+using LSMTree.SSTable;
+using LSMTree.SkipList;
+
+namespace LSMTree.Tests
+{
+    public static class StorageRegressionTests
+    {
+        public static async Task RunAllAsync()
+        {
+            var directory = Path.Combine(Path.GetTempPath(), "lsm-storage-regression-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(directory);
+            try
+            {
+                await ConcurrentBlockReadsAsync(directory);
+                await InvalidBlockHandleAsync(directory);
+                await CompactedDatabaseReadsAsync(directory);
+                await ConcurrentSkipListWritesAsync();
+                Console.WriteLine("Storage regressions: 4 scenarios passed.");
+            }
+            finally
+            {
+                Directory.Delete(directory, recursive: true);
+            }
+        }
+
+        public static async Task ConcurrentSkipListWritesAsync()
+        {
+            var list = new ConcurrentSkipList();
+            var start = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var tasks = Enumerable.Range(0, 32).Select(worker => Task.Run(async () =>
+            {
+                await start.Task;
+                for (int i = 0; i < 128; i++)
+                {
+                    var id = worker * 128 + i;
+                    list.Set(new Entry($"writer_{id:D5}", BitConverter.GetBytes(id)));
+                }
+            })).ToArray();
+            start.SetResult(true);
+            await Task.WhenAll(tasks);
+
+            // Each phase completes before the next; no ordering assumption between
+            // concurrent callers is needed to assert the final value and uniqueness.
+            for (int phase = 1; phase <= 3; phase++)
+            {
+                var value = phase;
+                await Task.WhenAll(Enumerable.Range(0, 32).Select(worker => Task.Run(() =>
+                {
+                    for (int i = 0; i < 128; i++)
+                    {
+                        var id = worker * 128 + i;
+                        list.Set(new Entry($"writer_{id:D5}", BitConverter.GetBytes(id + value)));
+                    }
+                })));
+            }
+            var all = list.GetAll().ToList();
+            if (all.Count != 4096 || all.Select(e => e.Key).Distinct().Count() != 4096)
+                throw new Exception("Concurrent skip-list writes lost or duplicated keys.");
+            for (int i = 0; i < 4096; i++)
+            {
+                var key = $"writer_{i:D5}";
+                var (found, entry) = list.Get(key);
+                if (!found || !entry.Value.SequenceEqual(BitConverter.GetBytes(i + 3)) || all[i].Key != key)
+                    throw new Exception($"Concurrent skip-list value/order mismatch: {key}");
+            }
+            Console.WriteLine("PASS: 32 skip-list writers preserve 4,096 unique sorted keys and phased updates.");
+        }
+
+        private static List<Entry> CreateEntries(int count)
+        {
+            var random = new Random(42);
+            return Enumerable.Range(0, count).Select(i =>
+            {
+                var value = new byte[128];
+                random.NextBytes(value);
+                return new Entry($"key_{i:D5}", value);
+            }).ToList();
+        }
+
+        private static async Task ConcurrentBlockReadsAsync(string directory)
+        {
+            var entries = CreateEntries(256);
+            var path = Path.Combine(directory, "concurrent.sst");
+            using (await SSTable.SSTable.BuildAsync(path, entries, dataBlockSize: 512)) { }
+            // No block cache: every lookup must exercise the shared table's file I/O.
+            using var table = await SSTable.SSTable.OpenAsync(path);
+            if (table._indexBlock!.Entries.Count < 32)
+                throw new Exception("Concurrency fixture must span many distinct blocks.");
+
+            var start = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var readers = Enumerable.Range(0, 32).Select(worker => Task.Run(async () =>
+            {
+                await start.Task;
+                for (int i = 0; i < 128; i++)
+                {
+                    var expected = entries[(worker * 17 + i * 31) % entries.Count];
+                    var (found, actual) = await table.SearchAsync(expected.Key);
+                    if (!found || !actual.Value.SequenceEqual(expected.Value))
+                        throw new Exception($"Concurrent block read mismatch: {expected.Key}");
+                }
+            })).ToList();
+            readers.Add(Task.Run(async () =>
+            {
+                await start.Task;
+                var actual = (await table.GetAllEntriesAsync()).ToList();
+                if (actual.Count != entries.Count || actual.Where((e, i) =>
+                    e.Key != entries[i].Key || !e.Value.SequenceEqual(entries[i].Value)).Any())
+                    throw new Exception("Concurrent enumeration returned incorrect entries.");
+            }));
+            start.SetResult(true);
+            await Task.WhenAll(readers);
+            Console.WriteLine("PASS: 4,096 uncached lookups and enumeration share one SSTable safely.");
+        }
+
+        private static async Task InvalidBlockHandleAsync(string directory)
+        {
+            // Corrupt the persisted footer, rather than just mocking a read method.
+            foreach (var handle in new[]
+            {
+                new BlockHandle(ulong.MaxValue, 1),
+                new BlockHandle(0, ulong.MaxValue),
+                new BlockHandle(0, 0)
+            })
+            {
+                var path = Path.Combine(directory, "invalid.sst");
+                using (await SSTable.SSTable.BuildAsync(path, CreateEntries(4))) { }
+                var bytes = await File.ReadAllBytesAsync(path);
+                var footer = new Footer();
+                footer.Decode(bytes.AsSpan(bytes.Length - Footer.FooterSize).ToArray());
+                footer.MetaBlockHandle = handle;
+                footer.Encode().CopyTo(bytes, bytes.Length - Footer.FooterSize);
+                await File.WriteAllBytesAsync(path, bytes);
+                try
+                {
+                    using var table = await SSTable.SSTable.OpenAsync(path);
+                    throw new Exception("Opening an out-of-bounds/empty block must fail.");
+                }
+                catch (InvalidDataException)
+                {
+                    // Invalid on-disk offsets/lengths must fail before allocation or decoding.
+                }
+            }
+            Console.WriteLine("PASS: invalid persisted block offsets/lengths are rejected.");
+        }
+
+        private static async Task CompactedDatabaseReadsAsync(string directory)
+        {
+            var path = Path.Combine(directory, "compacted");
+            var config = new LSMConfiguration
+            {
+                EnableBlockCache = false,
+                DataBlockSize = 512,
+                Level0CompactionTrigger = 100
+            };
+            var expected = CreateEntries(400).ToDictionary(e => e.Key, e => e.Value);
+            await using (var db = await LSMTreeDB.OpenAsync(path, config))
+            {
+                foreach (var batch in expected.Chunk(100))
+                {
+                    foreach (var pair in batch)
+                        await db.SetAsync(pair.Key, pair.Value);
+                    await db.FlushAsync();
+                }
+                // Include updates and tombstones in the compacted output.
+                expected["key_00000"] = new byte[] { 9, 8, 7 };
+                await db.SetAsync("key_00000", expected["key_00000"]);
+                expected.Remove("key_00001");
+                await db.DeleteAsync("key_00001");
+                await db.FlushAsync();
+                await db.CompactAsync();
+                await VerifyDatabaseAsync(db, expected);
+            }
+            await using (var reopened = await LSMTreeDB.OpenAsync(path, config))
+                await VerifyDatabaseAsync(reopened, expected);
+            Console.WriteLine("PASS: concurrent compacted reads, updates/deletion, and clean reopen.");
+        }
+
+        private static async Task VerifyDatabaseAsync(LSMTreeDB db, Dictionary<string, byte[]> expected)
+        {
+            await Task.WhenAll(expected.Select(async pair =>
+            {
+                var (found, actual) = await db.GetAsync(pair.Key);
+                if (!found || !actual.SequenceEqual(pair.Value))
+                    throw new Exception($"Compacted/reopened value mismatch: {pair.Key}");
+            }));
+            var (deletedFound, _) = await db.GetAsync("key_00001");
+            if (deletedFound)
+                throw new Exception("Deleted key reappeared after compaction/reopen.");
+        }
+    }
+}
